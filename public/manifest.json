{
  "manifest_version": 3,
  "name": "What's Above Me?",
  "version": "1.1",
  "description": "A new tab page that shows live ISS position data! Powered by ThreeJS and Vite",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "favicon"
  ],
  "host_permissions": [
    "https://api.wheretheiss.at/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
